# Google Gemini API Key for OCR Document Extraction & AI Decision Support
# Get your free key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Supabase Configuration for Prescriptions & Patient Tracking
# Find these under your Supabase Project Settings -> API
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_KEY=your_supabase_anon_or_service_role_key

# Optional: Host & Port configurations
PORT=8000
HOST=0.0.0.0
