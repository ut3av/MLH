{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "installCommand": "npm install --prefix amr-guard/frontend",
  "buildCommand": "npm run build --prefix amr-guard/frontend",
  "outputDirectory": "amr-guard/frontend/dist",
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "https://diyaaa.onrender.com/api/$1"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
